# ============================================================
# Interfon - configuracion del servidor
# Copia este archivo como .env y ajusta lo que necesites.
# ============================================================

# Red
HOST=0.0.0.0
PORT=8765

# API de inferencia local (Unsloth Studio / compatible OpenAI)
UNSLOTH_BASE=http://127.0.0.1:8888
LLM_MODEL=unsloth/gemma-4-E2B-it-GGUF
STT_MODEL=qwen3-asr-0.6b

# Voz del agente: auto | sapi | piper
#   sapi  = voces de Windows (Microsoft Sabina, es-MX). Cero dependencias.
#   piper = mejor calidad. Voz argentina femenina incluida via setup:
#           server/voices/es_AR-daniela-high.onnx (descargada de HuggingFace)
TTS_ENGINE=piper
TTS_VOICE_SAPI=Microsoft Sabina Desktop
PIPER_MODEL=voices/es_AR-daniela-high.onnx

# Personalidad del agente al hablar
AGENT_NAME=ZCode
SYSTEM_PROMPT=Eres ZCode, el agente de programacion del equipo, hablando por el telefono interno Interfon. Responde SIEMPRE en espanol, breve (maximo 2 frases), natural y hablado, sin markdown ni listas. Si el tema es largo, ofrece resumirlo frente a la computadora.

# Llamadas
RING_TIMEOUT=45
MAX_UTTERANCE_S=12
HISTORY_TURNS=8

# Puente Telegram (opcional): crea el bot con @BotFather y pega el token.
# Recomendado: ponlo en .secrets/.env (fuera del repo) junto a TELEGRAM_BOT_NAME;
# ese archivo tiene prioridad sobre este.
# El servidor lo detecta en caliente (sin reiniciar). El primer chat que
# envie /start al bot queda autorizado.
# Con TELEGRAM_MIRROR_PHONE=true, cada respuesta tambien suena en el telefono.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MIRROR_PHONE=false
